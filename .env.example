# Copy this file to .env.local (for your computer) and add the same values in
# your hosting dashboard (e.g. Vercel → Project → Settings → Environment Variables).

# Public website address, no trailing slash. Used for canonical links, sitemap, social previews.
NEXT_PUBLIC_SITE_URL=https://www.example.ca

# --- Contact form email (Resend: https://resend.com) ---
# API key from Resend → API Keys
RESEND_API_KEY=
# Where enquiries are delivered (comma-separate several addresses)
CONTACT_TO_EMAIL=
# The "from" address. Must use a domain you have verified in Resend, e.g. "Website <enquiries@yourdomain.ca>"
CONTACT_FROM_EMAIL=
# Set to "true" to log enquiries to the server console instead of emailing them (useful for testing)
CONTACT_FORM_DRY_RUN=false

# --- Analytics (optional, OFF by default) ---
# Leave empty for no analytics. "plausible" (cookieless, no banner) or "ga4" (shows a cookie consent banner).
NEXT_PUBLIC_ANALYTICS=
# Required if NEXT_PUBLIC_ANALYTICS=ga4 — e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=
# Required if NEXT_PUBLIC_ANALYTICS=plausible — your site domain as set up in Plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
